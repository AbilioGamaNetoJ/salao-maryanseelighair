---
import { SALON_INFO } from '../data/salonData';
---

<section id="inicio" class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 overflow-hidden bg-ivory">
  <!-- Soft atelier glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-gradient-to-br from-champagne/25 via-blush/10 to-transparent rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-gradient-to-tr from-sage/20 via-champagne-light/20 to-transparent rounded-full blur-[110px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-10 w-[350px] h-[350px] bg-sand/70 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1F1A140F_1px,transparent_1px),linear-gradient(to_bottom,#1F1A140F_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copywriting & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left space-y-6">
        
        <!-- Experience Shimmer Badge -->
        <div class="reveal-on-scroll inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-champagne/40 bg-champagne/10 shimmer-badge text-champagne-dark text-xs font-semibold uppercase tracking-[0.2em]">
          <span class="w-2 h-2 rounded-full bg-champagne animate-pulse"></span>
          <span>Mais de 19 Anos de Maestria &bull; Florianópolis</span>
        </div>

        <!-- Hero Title with Editorial Serif -->
        <h1 class="reveal-on-scroll font-serif-luxury text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-normal tracking-tight text-espresso leading-[1.08]">
          A arte das <span class="italic font-light gold-gradient-text">mechas naturais</span> & da beleza autoral.
        </h1>

        <!-- Subtitle -->
        <p class="reveal-on-scroll text-base sm:text-lg text-taupe font-light max-w-2xl leading-relaxed">
          Especialista em <strong class="text-espresso font-medium">mechas de baixa manutenção</strong>, visagismo em cortes personalizados, maquiagens de alta fixação e terapias capilares de luxo para mulheres exigentes.
        </p>

        <!-- CTA Buttons -->
        <div class="reveal-on-scroll flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto pt-2">
          <a 
            href={SALON_INFO.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="gold-gradient-btn w-full sm:w-auto px-8 py-4 rounded-full text-sm font-semibold uppercase tracking-wider flex items-center justify-center gap-3 shadow-[0_10px_30px_rgba(196,165,116,0.28)] hover:shadow-[0_15px_40px_rgba(196,165,116,0.4)] group"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Agendar Experiência VIP</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#portfolio" 
            class="w-full sm:w-auto px-7 py-4 rounded-full border border-champagne/40 hover:border-champagne bg-cream hover:bg-linen text-espresso hover:text-champagne-dark text-sm font-medium tracking-wide transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span>Explorar Galeria</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Trust Highlights Bar -->
        <div class="reveal-on-scroll grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 border-t border-champagne/25 w-full">
          <div class="flex items-center gap-2">
            <span class="text-champagne-dark">✦</span>
            <span class="text-xs text-taupe font-medium">Sem marcas na raiz</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-champagne-dark">✦</span>
            <span class="text-xs text-taupe font-medium">Cosmética Vegana</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-champagne-dark">✦</span>
            <span class="text-xs text-taupe font-medium">Vapor de Ozônio</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-champagne-dark">✦</span>
            <span class="text-xs text-taupe font-medium">Atendimento VIP</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Photo Composition & Floating Badges -->
      <div class="lg:col-span-5 relative flex justify-center items-center">
        
        <!-- Main Portrait Card -->
        <div class="relative w-full max-w-[380px] sm:max-w-[420px] aspect-[4/5] rounded-3xl p-2 bg-gradient-to-b from-champagne-light via-linen to-sage/40 shadow-[0_25px_60px_-20px_rgba(42,36,28,0.28),0_0_40px_rgba(196,165,116,0.18)] group">
          
          <div class="w-full h-full rounded-[22px] overflow-hidden relative bg-linen">
            <img 
              src="/images/profile/hero-cover.jpg" 
              alt="Maryana Seelig, colorista e visagista em Florianópolis" 
              class="w-full h-full object-cover object-[50%_12%] group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-espresso/45 via-transparent to-transparent"></div>

            <!-- Bottom Floating Caption inside Image -->
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl backdrop-blur-md bg-cream/90 border border-champagne/35 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-widest text-champagne-dark font-semibold">Colorista & Visagista</p>
                <p class="font-serif-luxury text-base text-espresso font-medium">Maryana Seelig</p>
              </div>
              <div class="w-8 h-8 rounded-full bg-champagne/20 border border-champagne/40 flex items-center justify-center text-champagne-dark">
                ✨
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Badge Top Right: 5.0 Google Review -->
        <div class="absolute -top-4 -right-2 sm:-right-6 glass-panel px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 animate-float-slow hidden sm:flex">
          <div class="w-9 h-9 rounded-full bg-champagne/20 border border-champagne/50 flex items-center justify-center text-champagne-dark font-bold text-xs">
            5.0
          </div>
          <div>
            <div class="flex text-champagne-dark text-xs">★★★★★</div>
            <p class="text-[11px] text-taupe font-medium">Excelência Comprovada</p>
          </div>
        </div>

        <!-- Floating Badge Bottom Left: Retoque Espaçado -->
        <div class="absolute -bottom-6 -left-2 sm:-left-6 glass-panel px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 animate-float-slow hidden sm:flex" style="animation-delay: 2.5s;">
          <div class="w-9 h-9 rounded-full bg-sage/20 border border-sage/40 flex items-center justify-center text-sage text-sm">
            🌿
          </div>
          <div>
            <p class="text-xs font-semibold text-espresso">Retoque 6 a 12 meses</p>
            <p class="text-[10px] text-taupe">Raiz 100% livre de marcas</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
