---
import { PORTFOLIO, SALON_INFO } from '../data/salonData';

const categories = [
  { id: 'todas', label: 'Todas as Fotos' },
  { id: 'mechas', label: 'Mechas & Loiros' },
  { id: 'makeup', label: 'Makeup & Penteados' },
  { id: 'cortes', label: 'Cortes & Visagismo' },
  { id: 'tratamentos', label: 'Spa Capilar' },
  { id: 'megahair', label: 'Mega Hair' }
];

const tabActive = 'bg-champagne text-espresso font-semibold shadow-[0_8px_20px_rgba(196,165,116,0.35)]';
const tabIdle = 'bg-cream text-taupe hover:text-espresso hover:bg-linen border border-champagne/25';
---

<section id="portfolio" class="py-24 bg-cream relative border-t border-champagne/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-12 space-y-4">
      <div class="section-badge">
        <span>✦ Portfólio Exclusivo ✦</span>
      </div>
      <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl font-normal text-espresso">
        Galeria de Trabalhos <span class="italic gold-gradient-text">Maryan Seelig</span>
      </h2>
      <p class="text-taupe text-sm sm:text-base">
        Acompanhe de perto as produções reais, tonalizações de mechas, cortes e maquiagens produzidas em Florianópolis.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="reveal-on-scroll flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-12">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category-btn={cat.id}
          class={`filter-tab px-5 py-2.5 rounded-full text-xs font-medium uppercase tracking-wider transition-all duration-300 ${
            idx === 0 ? tabActive : tabIdle
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="portfolio-grid">
      {PORTFOLIO.map((item) => (
        <div 
          class="portfolio-card group relative aspect-[4/5] rounded-2xl overflow-hidden bg-linen border border-champagne/20 hover:border-champagne/50 shadow-md cursor-pointer transition-all duration-500 hover:-translate-y-1.5"
          data-category={item.category}
          data-image={item.image}
          data-title={item.title}
          data-caption={item.caption}
          data-location={item.location || 'Florianópolis - SC'}
        >
          <!-- Image -->
          <img 
            src={item.image} 
            alt={item.title} 
            class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700 ease-out"
            loading="lazy"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-espresso/85 via-espresso/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
            
            <span class="text-[10px] uppercase font-semibold tracking-widest text-champagne-light mb-1">
              {item.location || 'Florianópolis'}
            </span>

            <h3 class="font-serif-luxury text-xl font-medium text-ivory leading-snug">
              {item.title}
            </h3>

            <p class="text-xs text-ivory/80 line-clamp-2 mt-1 font-light">
              {item.caption}
            </p>

            <div class="pt-3 mt-3 border-t border-ivory/20 flex items-center justify-between">
              <span class="text-[11px] text-champagne-light font-medium flex items-center gap-1">
                <span>Ampliar foto</span>
                <span>↗</span>
              </span>
              <span class="w-7 h-7 rounded-full bg-champagne/25 border border-champagne/40 flex items-center justify-center text-xs text-champagne-light">
                🔍
              </span>
            </div>

          </div>

          <!-- Subtle bottom title visible without hover on mobile -->
          <div class="sm:hidden absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-espresso/80 to-transparent">
            <p class="text-xs text-ivory font-medium truncate">{item.title}</p>
          </div>

        </div>
      ))}
    </div>

    <!-- Instagram Direct Link Callout -->
    <div class="reveal-on-scroll mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-4 sm:px-8 sm:py-4 rounded-2xl glass-panel border border-champagne/25">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-champagne to-blush flex items-center justify-center text-espresso font-bold text-sm">
            IG
          </div>
          <div class="text-left">
            <p class="text-xs font-semibold text-espresso uppercase tracking-wider">Acompanhe diariamente</p>
            <p class="text-sm text-champagne-dark">@maryanseelighair no Instagram</p>
          </div>
        </div>
        <a 
          href={SALON_INFO.instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-2 rounded-full border border-champagne/50 hover:bg-champagne hover:text-espresso text-champagne-dark text-xs font-semibold uppercase tracking-wider transition-all duration-300"
        >
          <span>Seguir Perfil</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Lightbox Modal -->
<div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-espresso/80 backdrop-blur-xl flex items-center justify-center p-4 sm:p-6 transition-all duration-300">
  <div class="relative w-full max-w-4xl max-h-[92vh] flex flex-col md:flex-row rounded-3xl overflow-hidden bg-cream border border-champagne/30 shadow-2xl">
    
    <!-- Close button -->
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-cream/90 hover:bg-champagne hover:text-espresso text-espresso flex items-center justify-center text-lg border border-champagne/30 transition-colors"
      aria-label="Fechar modal"
    >
      ✕
    </button>

    <!-- Modal Image Side -->
    <div class="md:w-3/5 bg-linen flex items-center justify-center p-2">
      <img id="lightbox-img" src="" alt="" class="max-h-[50vh] md:max-h-[85vh] w-auto object-contain rounded-xl" />
    </div>

    <!-- Modal Content Side -->
    <div class="md:w-2/5 p-6 sm:p-8 flex flex-col justify-between space-y-6 bg-cream">
      <div class="space-y-4">
        <span id="lightbox-location" class="inline-block px-3 py-1 rounded-full bg-champagne/10 border border-champagne/30 text-champagne-dark text-[11px] font-semibold uppercase tracking-wider">
          Florianópolis
        </span>
        <h3 id="lightbox-title" class="font-serif-luxury text-2xl sm:text-3xl text-espresso font-medium">
          Título
        </h3>
        <p id="lightbox-caption" class="text-sm text-taupe leading-relaxed font-light">
          Legenda
        </p>
      </div>

      <div class="pt-6 border-t border-champagne/20 space-y-3">
        <a 
          id="lightbox-booking-btn"
          href={SALON_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="gold-gradient-btn w-full py-3.5 rounded-xl text-center text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2"
        >
          <span>Quero este resultado</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-category-btn]');
  const cards = document.querySelectorAll<HTMLElement>('.portfolio-card');

  const activeClasses = ['bg-champagne', 'text-espresso', 'font-semibold', 'shadow-[0_8px_20px_rgba(196,165,116,0.35)]'];
  const idleClasses = ['bg-cream', 'text-taupe', 'hover:text-espresso', 'hover:bg-linen', 'border', 'border-champagne/25'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const selected = tab.getAttribute('data-category-btn');

      tabs.forEach((t) => {
        t.classList.remove(...activeClasses);
        t.classList.add(...idleClasses);
      });
      tab.classList.remove(...idleClasses);
      tab.classList.add(...activeClasses);

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'todas' || cat === selected) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const modalTitle = document.getElementById('lightbox-title');
  const modalCaption = document.getElementById('lightbox-caption');
  const modalLocation = document.getElementById('lightbox-location');
  const modalClose = document.getElementById('lightbox-close');
  const modalBookingBtn = document.getElementById('lightbox-booking-btn') as HTMLAnchorElement;

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const img = card.getAttribute('data-image') || '';
      const title = card.getAttribute('data-title') || '';
      const caption = card.getAttribute('data-caption') || '';
      const location = card.getAttribute('data-location') || 'Florianópolis';

      if (modalImg) modalImg.src = img;
      if (modalTitle) modalTitle.textContent = title;
      if (modalCaption) modalCaption.textContent = caption;
      if (modalLocation) modalLocation.textContent = location;

      if (modalBookingBtn) {
        modalBookingBtn.href = `https://api.whatsapp.com/send?phone=5548991335127&text=Ol%C3%A1%2C%20Maryana!%20Vi%20a%20foto%20*${encodeURIComponent(title)}*%20no%20seu%20site%20e%20gostaria%20de%20agendar%20um%20atendimento.`;
      }

      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });
  });

  const closeModal = () => {
    modal?.classList.add('hidden');
    document.body.style.overflow = 'auto';
  };

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
