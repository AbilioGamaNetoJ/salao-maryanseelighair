---
import { TESTIMONIALS } from '../data/salonData';
---

<section id="depoimentos" class="py-24 bg-linen relative border-t border-champagne/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="section-badge">
        <span>✦ Depoimentos Reais ✦</span>
      </div>
      <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl font-normal text-espresso">
        O que dizem as clientes que <span class="italic gold-gradient-text">confiam na nossa arte</span>
      </h2>
      <p class="text-taupe text-sm sm:text-base">
        A satisfação e a auto-estima elevada de quem viveu a experiência Maryan Seelig Concept.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {TESTIMONIALS.map((item) => (
        <div class="reveal-on-scroll glass-panel glass-panel-hover rounded-3xl p-8 flex flex-col justify-between space-y-6 relative group border border-champagne/20 hover:border-champagne/40">
          
          <!-- Quote Icon and Highlight -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1 text-champagne-dark text-base">
              {'★'.repeat(item.stars)}
            </div>
            <span class="px-3 py-1 rounded-full bg-champagne/10 border border-champagne/25 text-[11px] font-semibold uppercase tracking-wider text-champagne-dark">
              {item.highlight}
            </span>
          </div>

          <!-- Quote Text -->
          <blockquote class="text-taupe text-sm sm:text-base leading-relaxed italic font-light">
            "{item.quote}"
          </blockquote>

          <!-- Client Info -->
          <div class="flex items-center gap-4 pt-4 border-t border-champagne/20">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-champagne to-champagne-dark p-0.5 shadow-md flex items-center justify-center text-espresso font-serif-luxury font-bold text-lg">
              {item.name.charAt(0)}
            </div>
            <div>
              <p class="font-serif-luxury text-lg font-medium text-espresso">{item.name}</p>
              <p class="text-xs text-taupe">{item.role}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
