---
import { TESTIMONIALS } from '../data/salonData';
---

<section id="depoimentos" class="py-24 bg-[#111114] relative border-t border-amber-500/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-amber-500/30 bg-amber-500/5 text-amber-300 text-xs font-semibold uppercase tracking-[0.2em]">
        <span>✦ Depoimentos Reais ✦</span>
      </div>
      <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl font-normal text-[#FAF7F2]">
        O que dizem as clientes que <span class="italic gold-gradient-text">confiam na nossa arte</span>
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base">
        A satisfação e a auto-estima elevada de quem viveu a experiência Maryan Seelig Concept.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {TESTIMONIALS.map((item) => (
        <div class="reveal-on-scroll glass-panel glass-panel-hover rounded-3xl p-8 flex flex-col justify-between space-y-6 relative group border border-neutral-800 hover:border-amber-500/30">
          
          <!-- Quote Icon and Highlight -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1 text-amber-400 text-base">
              {'★'.repeat(item.stars)}
            </div>
            <span class="px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-[11px] font-semibold uppercase tracking-wider text-amber-300">
              {item.highlight}
            </span>
          </div>

          <!-- Quote Text -->
          <blockquote class="text-neutral-300 text-sm sm:text-base leading-relaxed italic font-light">
            "{item.quote}"
          </blockquote>

          <!-- Client Info -->
          <div class="flex items-center gap-4 pt-4 border-t border-neutral-800/80">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-amber-500 to-amber-700 p-0.5 shadow-md flex items-center justify-center text-black font-serif-luxury font-bold text-lg">
              {item.name.charAt(0)}
            </div>
            <div>
              <p class="font-serif-luxury text-lg font-medium text-neutral-100">{item.name}</p>
              <p class="text-xs text-neutral-400">{item.role}</p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
