---
import BrandLogo from './BrandLogo.astro';
import { SALON_INFO } from '../data/salonData';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-xl bg-[#0A0908]/90 border-b border-amber-500/15" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo -->
      <BrandLogo />

      <!-- Desktop Nav Links (No Wrap) -->
      <nav class="hidden xl:flex items-center space-x-6 2xl:space-x-8 shrink-0">
        <a href="#inicio" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Início</a>
        <a href="#servicos" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Serviços</a>
        <a href="#experiencia" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">A Experiência</a>
        <a href="#transformacoes" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Antes & Depois</a>
        <a href="#portfolio" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Galeria</a>
        <a href="#depoimentos" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Avaliações</a>
        <a href="#localizacao" class="text-xs font-medium uppercase tracking-wider text-neutral-300 hover:text-amber-300 transition-colors whitespace-nowrap">Localização</a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center space-x-4">
        <!-- Instagram Link -->
        <a 
          href={SALON_INFO.instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-300 hover:text-amber-300 hover:border-amber-500/40 transition-all duration-300"
          aria-label="Instagram Maryan Seelig"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- WhatsApp Booking CTA -->
        <a 
          href={SALON_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="gold-gradient-btn px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider flex items-center gap-2 shadow-[0_4px_20px_rgba(212,175,55,0.25)]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Agendar Horário</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center xl:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 rounded-lg text-neutral-400 hover:text-amber-300 hover:bg-neutral-900/80 focus:outline-none" 
          aria-label="Abrir Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" id="menu-icon-bars" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="hidden" id="menu-icon-close" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-b border-amber-500/20 bg-[#0E0D0E]/98 backdrop-blur-xl transition-all duration-300 px-6 py-6 space-y-4">
    <a href="#inicio" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Início</a>
    <a href="#servicos" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Serviços</a>
    <a href="#experiencia" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">A Experiência</a>
    <a href="#transformacoes" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Antes & Depois</a>
    <a href="#portfolio" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Galeria</a>
    <a href="#depoimentos" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Avaliações</a>
    <a href="#localizacao" class="mobile-nav-link block text-base font-medium text-neutral-200 hover:text-amber-300">Localização</a>

    <div class="pt-4 border-t border-neutral-800 flex flex-col gap-3">
      <a 
        href={SALON_INFO.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="gold-gradient-btn w-full py-3 rounded-xl text-center text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2"
      >
        <span>Agendar pelo WhatsApp</span>
      </a>
      <a 
        href={SALON_INFO.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="w-full py-2.5 rounded-xl border border-neutral-700 text-neutral-300 text-center text-xs font-medium uppercase tracking-wider flex items-center justify-center gap-2 hover:border-amber-400/50"
      >
        <span>Ver Instagram @maryanseelighair</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      iconBars?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
