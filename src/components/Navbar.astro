---
import BrandLogo from './BrandLogo.astro';
import { SALON_INFO } from '../data/salonData';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-xl bg-ivory/90 border-b border-champagne/20" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo -->
      <BrandLogo variant="icon" />

      <!-- Desktop Nav Links (No Wrap) -->
      <nav class="hidden xl:flex items-center space-x-6 2xl:space-x-8 shrink-0">
        <a href="#inicio" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Início</a>
        <a href="#servicos" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Serviços</a>
        <a href="#experiencia" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">A Experiência</a>
        <a href="#transformacoes" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Antes & Depois</a>
        <a href="#portfolio" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Galeria</a>
        <a href="#depoimentos" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Avaliações</a>
        <a href="#localizacao" class="text-xs font-medium uppercase tracking-wider text-taupe hover:text-champagne-dark transition-colors whitespace-nowrap">Localização</a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center">
        <!-- WhatsApp Booking CTA -->
        <a 
          href={SALON_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="gold-gradient-btn px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider flex items-center gap-2 shadow-[0_4px_20px_rgba(212,175,55,0.28)]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Agendar Horário</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center xl:hidden">
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 rounded-lg text-taupe hover:text-champagne-dark hover:bg-linen focus:outline-none" 
          aria-label="Abrir Menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" id="menu-icon-bars" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" class="hidden" id="menu-icon-close" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-b border-champagne/20 bg-ivory/98 backdrop-blur-xl transition-all duration-300 px-6 py-6 space-y-4">
    <a href="#inicio" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Início</a>
    <a href="#servicos" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Serviços</a>
    <a href="#experiencia" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">A Experiência</a>
    <a href="#transformacoes" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Antes & Depois</a>
    <a href="#portfolio" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Galeria</a>
    <a href="#depoimentos" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Avaliações</a>
    <a href="#localizacao" class="mobile-nav-link block text-base font-medium text-espresso hover:text-champagne-dark">Localização</a>

    <div class="pt-4 border-t border-champagne/20">
      <a 
        href={SALON_INFO.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="gold-gradient-btn w-full py-3 rounded-xl text-center text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2"
      >
        <span>Agendar pelo WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      iconBars?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconBars?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
