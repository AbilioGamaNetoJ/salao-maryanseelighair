---
import { SALON_INFO } from '../data/salonData';
---

<section id="experiencia" class="py-24 bg-[#161412] relative overflow-hidden border-t border-amber-500/10">
  <!-- Subtle lighting background -->
  <div class="absolute -right-20 top-1/3 w-[500px] h-[500px] bg-amber-500/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Portrait & Quality Stamp -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-[360px] sm:max-w-[400px]">
          
          <!-- Golden border container -->
          <div class="aspect-[3/4] rounded-3xl p-2 bg-gradient-to-b from-amber-400/30 via-neutral-800 to-amber-900/20 shadow-2xl overflow-hidden">
            <div class="w-full h-full rounded-[20px] overflow-hidden relative">
              <img 
                src="/images/profile/maryana_seelig.jpg" 
                alt="Maryana Seelig Hair Stylist & Makeup Artist Florianópolis" 
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#121110] via-transparent to-transparent opacity-60"></div>
            </div>
          </div>

          <!-- Quality Stamp Tag -->
          <div class="absolute -bottom-5 -right-3 sm:-right-6 glass-panel px-5 py-4 rounded-2xl border border-amber-500/30 shadow-2xl backdrop-blur-xl">
            <p class="font-serif-luxury text-2xl font-semibold text-amber-300">19+ Anos</p>
            <p class="text-[11px] uppercase tracking-wider text-neutral-300 font-medium">De Dedicação e Arte</p>
          </div>

        </div>
      </div>

      <!-- Right Column: Biography, Values & Differentiators -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <div class="reveal-on-scroll inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-amber-500/30 bg-amber-500/5 text-amber-300 text-xs font-semibold uppercase tracking-[0.2em]">
          <span>✦ A Especialista ✦</span>
        </div>

        <h2 class="reveal-on-scroll font-serif-luxury text-3xl sm:text-4xl md:text-5xl font-normal text-[#FAF7F2] leading-tight">
          Cuidar de você não é apenas um serviço. <span class="italic gold-gradient-text">É uma experiência de bem-estar.</span>
        </h2>

        <p class="reveal-on-scroll text-neutral-300 text-sm sm:text-base leading-relaxed">
          {SALON_INFO.bio}
        </p>

        <!-- 3 Pillar Cards -->
        <div class="reveal-on-scroll grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
          
          <div class="p-5 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/30 transition-all">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-3 mx-auto lg:mx-0">
              💎
            </div>
            <h4 class="font-serif-luxury text-lg font-medium text-neutral-100">Visagismo Autoral</h4>
            <p class="text-xs text-neutral-400 mt-1 leading-relaxed">Cortes e tonalizações pensados para valorizar a arquitetura do seu rosto.</p>
          </div>

          <div class="p-5 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/30 transition-all">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-3 mx-auto lg:mx-0">
              🌿
            </div>
            <h4 class="font-serif-luxury text-lg font-medium text-neutral-100">Cosmética Nobre</h4>
            <p class="text-xs text-neutral-400 mt-1 leading-relaxed">Uso de linhas veganas e livres de agressões para preservar a saúde do fio.</p>
          </div>

          <div class="p-5 rounded-2xl bg-neutral-900/60 border border-neutral-800 hover:border-amber-500/30 transition-all">
            <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-3 mx-auto lg:mx-0">
              ☕
            </div>
            <h4 class="font-serif-luxury text-lg font-medium text-neutral-100">Espaço Aconchegante</h4>
            <p class="text-xs text-neutral-400 mt-1 leading-relaxed">Ambiente exclusivo, climatizado e pensado para você relaxar do início ao fim.</p>
          </div>

        </div>

        <!-- Quote & Signature -->
        <div class="reveal-on-scroll pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-neutral-800">
          <blockquote class="italic text-neutral-400 text-xs sm:text-sm font-light">
            "A beleza autêntica surge quando você se reconhece no espelho com leveza e confiança."
          </blockquote>
          <div class="text-right">
            <p class="font-serif-luxury text-lg text-amber-300 font-medium">Maryana Seelig</p>
            <p class="text-[10px] uppercase tracking-widest text-neutral-400">Founder & Hair Artist</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
