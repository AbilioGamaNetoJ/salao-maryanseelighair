---
import { SALON_INFO } from '../data/salonData';
---

<section id="agendamento" class="py-24 bg-ivory relative border-t border-champagne/15">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="reveal-on-scroll glass-panel rounded-3xl p-8 sm:p-12 border border-champagne/30 shadow-[0_20px_60px_-20px_rgba(42,36,28,0.16)] relative overflow-hidden">
      
      <!-- Top Decorative Accent -->
      <div class="absolute -top-24 -right-24 w-60 h-60 bg-champagne/15 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Header -->
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
        <span class="section-badge">
          ✦ Agendamento Personalizado ✦
        </span>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl text-espresso font-medium">
          Monte sua <span class="italic gold-gradient-text">experiência de beleza</span>
        </h2>
        <p class="text-taupe text-sm">
          Selecione os procedimentos desejados abaixo para gerar sua solicitação personalizada e enviar direto no WhatsApp.
        </p>
      </div>

      <!-- Interactive Form -->
      <form id="booking-form" class="space-y-8">
        
        <!-- Step 1: Select Services -->
        <div class="space-y-3">
          <label class="block text-xs uppercase tracking-widest text-champagne-dark font-semibold">
            1. Escolha os serviços desejados:
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            
            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Mechas de Baixa Manutenção" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Mechas de Baixa Manutenção</p>
                <p class="text-[11px] text-taupe">Raiz esfumada e natural</p>
              </div>
            </label>

            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Loiro Diva / Correção de Cor" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Loiros dos Sonhos</p>
                <p class="text-[11px] text-taupe">Clareamento & Matização</p>
              </div>
            </label>

            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Corte Personalizado com Visagismo" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Corte com Visagismo</p>
                <p class="text-[11px] text-taupe">Linhas sob medida</p>
              </div>
            </label>

            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Maquiagem Profissional / Glow" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Maquiagem Profissional</p>
                <p class="text-[11px] text-taupe">Pele blindada & Glow</p>
              </div>
            </label>

            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Penteado para Noivas / Eventos" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Penteados para Festas</p>
                <p class="text-[11px] text-taupe">Semipreso, coques e luxo</p>
              </div>
            </label>

            <label class="service-checkbox-label flex items-start gap-3 p-4 rounded-xl bg-cream border border-champagne/20 cursor-pointer hover:border-champagne/50 transition-all">
              <input type="checkbox" name="services" value="Spa Capilar Vapor de Ozônio (Keune)" class="mt-1 accent-champagne w-4 h-4 rounded" />
              <div>
                <p class="text-sm font-medium text-espresso">Spa Vapor de Ozônio</p>
                <p class="text-[11px] text-taupe">Linha vegana Keune So Pure</p>
              </div>
            </label>

          </div>
        </div>

        <!-- Step 2: Client Name & Preferred Shift -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="client-name" class="block text-xs uppercase tracking-widest text-espresso font-semibold">
              2. Seu Nome:
            </label>
            <input 
              type="text" 
              id="client-name" 
              placeholder="Ex: Gabriela Santos" 
              class="w-full px-4 py-3 rounded-xl bg-cream border border-champagne/25 text-espresso placeholder-taupe/60 focus:outline-none focus:border-champagne transition-colors text-sm"
              required
            />
          </div>

          <div class="space-y-2">
            <label for="client-shift" class="block text-xs uppercase tracking-widest text-espresso font-semibold">
              3. Melhor Turno para Atendimento:
            </label>
            <select 
              id="client-shift" 
              class="w-full px-4 py-3 rounded-xl bg-cream border border-champagne/25 text-espresso focus:outline-none focus:border-champagne transition-colors text-sm"
            >
              <option value="Manhã (09h às 13h)">Manhã (09h às 13h)</option>
              <option value="Tarde (13h às 19h)">Tarde (13h às 19h)</option>
              <option value="Sábado / Horário Especial">Sábado / Horário Especial</option>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-2 text-center">
          <button 
            type="submit"
            class="gold-gradient-btn w-full sm:w-auto px-10 py-4 rounded-full text-xs sm:text-sm font-semibold uppercase tracking-wider flex items-center justify-center gap-3 mx-auto shadow-[0_10px_35px_rgba(196,165,116,0.3)]"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Enviar Solicitação no WhatsApp</span>
          </button>
          <p class="text-[11px] text-taupe mt-2">
            Resposta rápida diretamente com a Maryana Seelig (+55 48 99133-5127).
          </p>
        </div>

      </form>

    </div>

  </div>
</section>

<script>
  import confetti from 'canvas-confetti';

  const form = document.getElementById('booking-form') as HTMLFormElement;
  const nameInput = document.getElementById('client-name') as HTMLInputElement;
  const shiftSelect = document.getElementById('client-shift') as HTMLSelectElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const selectedCheckboxes = document.querySelectorAll<HTMLInputElement>('input[name="services"]:checked');
    const services = Array.from(selectedCheckboxes).map(cb => cb.value);

    const name = nameInput.value.trim() || 'Cliente';
    const shift = shiftSelect.value;

    let message = `Olá, Maryana! Me chamo *${name}*.\n`;
    if (services.length > 0) {
      message += `Gostaria de agendar para os seguintes serviços:\n- ${services.join('\n- ')}\n`;
    } else {
      message += `Gostaria de agendar um atendimento e avaliação no salão.\n`;
    }
    message += `Prefiro o turno: *${shift}*.\nComo está sua disponibilidade de agenda?`;

    try {
      confetti({
        particleCount: 80,
        spread: 70,
        origin: { y: 0.7 },
        colors: ['#C4A574', '#E8D5B0', '#8A9688', '#C9958C']
      });
    } catch (_) {}

    const whatsappUrl = `https://api.whatsapp.com/send?phone=5548991335127&text=${encodeURIComponent(message)}`;
    
    setTimeout(() => {
      window.open(whatsappUrl, '_blank');
    }, 400);
  });
</script>
