---
import { SALON_INFO } from '../data/salonData';
---

<section id="localizacao" class="py-24 bg-ivory relative border-t border-champagne/25">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="section-badge">
        <span>✦ Localização Privilegiada ✦</span>
      </div>
      <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl font-normal text-espresso">
        Venha viver um momento de <span class="italic gold-gradient-text">puro cuidado e relaxamento</span>
      </h2>
      <p class="text-taupe text-sm sm:text-base">
        Ambiente exclusivo e acolhedor em Florianópolis - SC, com fácil acesso e comodidade.
      </p>
    </div>

    <!-- Main Grid: Info + Maps Embed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Details & Route Buttons -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        
        <!-- Info Cards -->
        <div class="space-y-4">
          
          <div class="glass-panel p-6 rounded-2xl border border-champagne/20 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-champagne/15 border border-champagne/25 flex items-center justify-center text-champagne-dark shrink-0 text-lg">
              📍
            </div>
            <div>
              <h4 class="font-serif-luxury text-lg font-medium text-espresso">Endereço & Atendimento</h4>
              <p class="text-xs sm:text-sm text-taupe mt-1 leading-relaxed">
                Florianópolis - Santa Catarina<br />
                <span class="text-taupe/80 text-xs">Atendimento no salão e produções especiais em Jurerê Internacional e região metropolitana.</span>
              </p>
            </div>
          </div>

          <div class="glass-panel p-6 rounded-2xl border border-champagne/20 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-champagne/15 border border-champagne/25 flex items-center justify-center text-champagne-dark shrink-0 text-lg">
              ⏰
            </div>
            <div>
              <h4 class="font-serif-luxury text-lg font-medium text-espresso">Horário de Funcionamento</h4>
              <p class="text-xs sm:text-sm text-taupe mt-1 leading-relaxed">
                {SALON_INFO.hours}<br />
                <span class="text-champagne-dark text-xs font-medium">Domingo e Segunda: Fechado (ou eventos agendados)</span>
              </p>
            </div>
          </div>

          <div class="glass-panel p-6 rounded-2xl border border-champagne/20 flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-sage/15 border border-sage/30 flex items-center justify-center text-sage shrink-0 text-lg">
              ✨
            </div>
            <div>
              <h4 class="font-serif-luxury text-lg font-medium text-espresso">Comodidades Exclusivas</h4>
              <ul class="text-xs text-taupe mt-1 space-y-1">
                <li>• Ambiente climatizado e aconchegante</li>
                <li>• Café especial, espumante e mimos</li>
                <li>• Estacionamento prático e seguro</li>
              </ul>
            </div>
          </div>

        </div>

        <!-- Navigation Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a 
            href={SALON_INFO.mapsShareUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex-1 gold-gradient-btn py-3 px-4 rounded-xl text-center text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Abrir no Google Maps</span>
          </a>

          <a 
            href={SALON_INFO.whatsappUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="py-3 px-5 rounded-xl border border-champagne/35 hover:border-champagne text-champagne-dark hover:text-espresso bg-cream text-xs font-medium uppercase tracking-wider flex items-center justify-center gap-2 transition-colors"
          >
            <span>Falar no WhatsApp</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Embedded Interactive Google Maps Frame -->
      <div class="lg:col-span-7 rounded-3xl overflow-hidden border border-champagne/30 shadow-xl relative min-h-[380px] sm:min-h-[460px] bg-sand group">
        
        <iframe
          title="Mapa do Salão Maryana Seelig Florianópolis"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d113175.76295325178!2d-48.61869818469857!3d-27.59487063467645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9527394ef3ddc7bb%3A0x6b1079d363297a76!2sFlorian%C3%B3polis%2C%20SC!5e0!3m2!1spt-BR!2sbr!4v1700000000000!5m2!1spt-BR!2sbr"
          width="100%"
          height="100%"
          style="border:0; filter: saturate(0.85) contrast(0.98);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full min-h-[420px]"
        ></iframe>

        <!-- Floating Badge on Map -->
        <div class="absolute bottom-4 left-4 right-4 sm:right-auto glass-panel p-4 rounded-2xl border border-champagne/30 shadow-xl backdrop-blur-xl flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-champagne text-espresso flex items-center justify-center font-bold text-sm shadow-md">
            MS
          </div>
          <div>
            <p class="font-serif-luxury text-base font-medium text-espresso">Maryan Seelig Hair Concept</p>
            <p class="text-[11px] text-champagne-dark">Florianópolis &bull; Santa Catarina</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
